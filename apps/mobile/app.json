{
  "expo": {
    "name": "Stride+",
    "slug": "stride-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "strideplus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.baggy102.strideplus",
      "appleTeamId": "22KN2RK655",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "러닝 경로를 기록하기 위해 위치 정보가 필요합니다.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "백그라운드에서도 러닝 경로를 정확히 기록합니다.",
        "UIBackgroundModes": [
          "location"
        ],
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.baggy102.strideplus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B1016"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1016",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0B1016"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "백그라운드에서도 러닝 경로를 정확히 기록합니다.",
          "locationWhenInUsePermission": "러닝 경로를 기록하기 위해 위치 정보가 필요합니다.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "러닝 기록에 첨부할 사진을 고르기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://192.168.1.102:3000"
    },
    "icon": "./assets/images/icon.png"
  }
}
