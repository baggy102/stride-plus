{
  "expo": {
    "name": "Stride+",
    "slug": "stride-plus",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/40f9cf01-ed4a-4ed3-9928-642ef3195a42"
    },
    "orientation": "portrait",
    "scheme": "strideplus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.baggy102.strideplus",
      "appleTeamId": "22KN2RK655",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "러닝 경로를 기록하고 내 주변 러닝을 보여 주려면 위치 정보가 필요해요.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "화면이 꺼져도 러닝 경로를 이어서 기록하려면 필요해요.",
        "UIBackgroundModes": [
          "location"
        ],
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.baggy102.strideplus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B1016"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1016",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0B1016"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "화면이 꺼져도 러닝 경로를 이어서 기록하려면 필요해요.",
          "locationWhenInUsePermission": "러닝 경로를 기록하고 내 주변 러닝을 보여 주려면 위치 정보가 필요해요.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "러닝 기록에 붙일 사진을 고르려면 사진 권한이 필요해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@bacons/apple-targets",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://192.168.1.102:3000",
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.baggy102.strideplus.live",
                  "targetName": "StrideLive"
                }
              ]
            }
          }
        },
        "projectId": "40f9cf01-ed4a-4ed3-9928-642ef3195a42"
      }
    },
    "icon": "./assets/images/icon.png",
    "owner": "baggy102"
  }
}
